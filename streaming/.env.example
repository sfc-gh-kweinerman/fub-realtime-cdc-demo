# ── SQL Server (Jack Henry simulation) ────────────────────────
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=FUBDemo!2026
SQLSERVER_DATABASE=JackHenry

# ── Snowflake connection ───────────────────────────────────────
# Account identifier: orgname-accountname  (e.g. myorg-myaccount)
# Find yours: SELECT CURRENT_ACCOUNT() in Snowsight
SNOWFLAKE_ACCOUNT=your_org-your_account
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_DATABASE=FUB_DEMO
SNOWFLAKE_SCHEMA=BANKING
SNOWFLAKE_WAREHOUSE=FUB_DEMO_WH

# ── Snowpipe Streaming (optional) ─────────────────────────────
# Set to true only after configuring key pair auth on your user.
# Instructions in README under "Enabling Snowpipe Streaming".
ENABLE_SNOWPIPE_STREAMING=false

# Path to your RSA private key (PEM format, unencrypted or passphrase below)
# SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# ── Generator settings ────────────────────────────────────────
DEFAULT_TPS=10
SEED_CUSTOMERS=100
SEED_ACCOUNTS=150

# ── Service ports ─────────────────────────────────────────────
GENERATOR_PORT=8081
POLLER_PORT=8080

# ── Polling interval (milliseconds) ──────────────────────────
POLL_INTERVAL_MS=500
