# ── Snowflake connection ───────────────────────────────────────
# Account identifier (orgname-accountname). Run: SELECT CURRENT_ACCOUNT()
SNOWFLAKE_ACCOUNT=your_org-your_account
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_DATABASE=FUB_DEMO
SNOWFLAKE_SCHEMA=BANKING
SNOWFLAKE_WAREHOUSE=FUB_DEMO_WH

# ── Mock mode (no Snowflake required) ─────────────────────────
# Set to "true" to run the UI with generated fake data.
# Useful for UI demos before Snowflake access is configured.
MOCK_MODE=false

# ── Python services (local) ───────────────────────────────────
# These URLs are used by Next.js API routes to proxy control calls
# to the Python generator and poller services.
POLLER_URL=http://localhost:8080
GENERATOR_URL=http://localhost:8081
