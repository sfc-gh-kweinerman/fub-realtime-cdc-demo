# Snowflake DSN for Redpanda Connect sql_raw output
#
# Password auth format:
#   SNOWFLAKE_DSN=user:password@account/FUB_DEMO/BANKING?warehouse=FUB_DEMO_WH&role=SYSADMIN
#
# Key pair auth format:
#   SNOWFLAKE_DSN=user@account/FUB_DEMO/BANKING?warehouse=FUB_DEMO_WH&role=SYSADMIN&authenticator=snowflake_jwt&privateKey=BASE64URL_ENCODED_KEY
#
# To generate the base64url-encoded private key from an unencrypted .p8 file:
#   openssl enc -d -base64 -in rsa_key.p8 | basenc --base64url -w0
#   (on macOS with coreutils: gbasenc --base64url -w0)

SNOWFLAKE_DSN=your_user:your_password@your_account/FUB_DEMO/BANKING?warehouse=FUB_DEMO_WH&role=SYSADMIN
